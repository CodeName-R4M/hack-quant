# Quantum Traffic Brain - Environment Configuration Example
# Copy this file to .env and adjust any values as needed.

# Cryptographic secret for JWT authentication (emergency dispatch tokens - leave empty to auto-generate ephemeral secret)
JWT_SECRET=

# Map tile provider ('carto_dark', 'osm', 'google_demo')
MAP_TILE_PROVIDER=carto_dark

# Optional CartoDB / Tile service API Key (not required for standard OSM/Carto tiles)
CARTODB_API_KEY=

# Optional Google Maps API key (DEMO ONLY - keep blank to use default open cartography)
GOOGLE_MAPS_API_KEY=

# Quantum Hardware Runner Credentials (OPTIONAL - scripts/run_on_qpu.py)
# AWS Braket credentials (or configure standard ~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BRAKET_S3_BUCKET=

# IBM Quantum credentials (or configure via Qiskit runtime save_account)
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=

