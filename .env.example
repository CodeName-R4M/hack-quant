# Quantum Traffic Brain - Environment Configuration Example
# Copy this file to .env and adjust any values as needed.

# Cryptographic secret for JWT authentication (emergency dispatch tokens)
JWT_SECRET=quant-traffic-jwt-key-chennai-sec-2026

# Map tile provider ('carto_dark', 'osm', 'google_demo')
MAP_TILE_PROVIDER=carto_dark

# Optional CartoDB / Tile service API Key (not required for standard OSM/Carto tiles)
CARTODB_API_KEY=

# Optional Google Maps API key (DEMO ONLY - keep blank to use default open cartography)
GOOGLE_MAPS_API_KEY=
